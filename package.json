{
  "name": "percept-cloud-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test --project=authenticated",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed --project=authenticated",
    "test:debug": "playwright test --debug --project=authenticated",
    "test:onboarding": "playwright test --project=onboarding",
    "test:ui:onboarding": "playwright test --ui --project=onboarding",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "dotenv": "^18.0.3",
    "typescript": "latest"
  }
}
